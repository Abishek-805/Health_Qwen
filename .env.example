# Express + Vite share this port.
PORT=3000
NODE_ENV=development

# Default English generation and audits run locally without a cloud key.
# Extraction always requires the local GGUF model: npm run download-model
GEMINI_GENERATION_ENABLED=false
GEMINI_AUDIT_ENABLED=false

# Optional cloud operations (including section regeneration and /api/ai-status).
# These operations send patient content to Google when invoked.
GEMINI_API_KEY=
# GEMINI_API_KEY_BACKUP=
# Set an available model identifier for your Google account before cloud use.
# GEMINI_MODEL=
