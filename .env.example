PORT=3000
NODE_ENV=development
# DATA_PATH=C:/PrivateClinicalData/discharge.sqlite

# Optional configured local account. Otherwise startup generates .runtime/login.txt.
# APP_USERNAME=clinician
# APP_PASSWORD=use-a-unique-password-at-least-16-characters

# Explicit cloud opt-in. Local extraction and English generation need no cloud key.
CLOUD_PROCESSING_ENABLED=false
GEMINI_GENERATION_ENABLED=false
GEMINI_AUDIT_ENABLED=false
GEMINI_API_KEY=
# GEMINI_API_KEY_BACKUP=
# GEMINI_MODEL=an-available-model-identifier-for-your-account
